import serial
import time
import math
import atexit
from picamera2 import Picamera2
import cv2
import numpy as np

# ============================================================
# 1. 통신 설정
# ============================================================

port_L = "/dev/ttyUSB0"
port_Ardu = "/dev/ttyS0"

baudrate_L = 460800
baudrate_Ardu = 460800

ARRIVE_AREA = 8000

ser_L = serial.Serial(port_L, baudrate_L, timeout=1)
ser_Ardu = serial.Serial(port_Ardu, baudrate_Ardu, timeout=1)

# ============================================================
# 2. 파라미터
# ============================================================

MIN_DIST = 80.0

CAR_HALF_WIDTH = 100.0
SAFETY_MARGIN = 30.0
PATH_HALF_WIDTH = CAR_HALF_WIDTH + SAFETY_MARGIN  # 130mm

PATH_CHECK_DIST = 650.0
PATH_DANGER_DIST = 520.0
PATH_BLOCK_POINTS = 3

LOOKAHEAD_DIST = 700.0
OPEN_SIDE_WIDTH = 330.0
CENTER_WIDTH = PATH_HALF_WIDTH
CENTER_BLOCK_DIST = 560.0
CENTER_BLOCK_POINTS = 3

SIDE_CHECK_DIST = 350.0
SIDE_MAX_SCORE_DIST = 400.0

STUCK_FRONT_DIST = 150.0
STUCK_POINTS = 8

NORMAL_SPEED = 0.52
AVOID_SPEED = 0.35
BACK_SPEED = 0.42
ESCAPE_SPEED = 0.40

AVOID_STEER = 0.65
ESCAPE_STEER = 0.70

STEER_SIGN = -1
SMOOTH = 0.30
prev_steer = 0.0

MODE_NORMAL = 0
MODE_BACK = 1
MODE_ESCAPE = 2

mode = MODE_NORMAL

TARGET_RED = 0
TARGET_YELLOW = 1
TARGET_BLUE = 2
TARGET_DONE = 3

target_color = TARGET_RED

last_seen_time = 0.0
last_steer = 0.0

COLOR_MEMORY_TIME = 2.0

ARRIVE_TIME = 1.0
arrive_start = None

back_count = 0
escape_count = 0
escape_dir = 0

BACK_CYCLES = 6
ESCAPE_CYCLES = 7

# ============================================================
# 3. 종료 처리
# ============================================================

def cleanup():
    try:
        ser_Ardu.write(b"S\n")
        ser_L.write(bytes([0xA5, 0x25]))  # STOP
        time.sleep(0.1)
        ser_L.close()
        ser_Ardu.close()
    except Exception:
        pass

atexit.register(cleanup)

# ============================================================
# 4. 카메라 초기화
# ============================================================

picam2 = Picamera2()
config = picam2.create_preview_configuration(main={"size": (640, 480)})
picam2.configure(config)
picam2.start()
time.sleep(2)

# ============================================================
# 5. 보조 함수들
# ============================================================

def clamp(value, low, high):
    return max(low, min(high, value))

def send_forward(steer, speed):
    global prev_steer
    steer = clamp(steer, -0.60, 0.60)
    speed = clamp(speed, 0.0, 1.0)
    steer = SMOOTH * prev_steer + (1.0 - SMOOTH) * steer
    steer = clamp(steer, -0.60, 0.60)
    prev_steer = steer
    ser_Ardu.write(f"F {steer:.2f} {speed:.2f}\n".encode())

def send_backward(speed=BACK_SPEED):
    global prev_steer
    prev_steer = 0.0
    speed = clamp(speed, 0.0, 1.0)
    ser_Ardu.write(f"B {speed:.2f}\n".encode())

def normalize_angle(angle):
    if angle > 180:
        angle -= 360
    return angle

def polar_to_xy(angle, distance):
    a = normalize_angle(angle)
    theta = math.radians(a)
    x = distance * math.cos(theta)
    y = distance * math.sin(theta)
    return x, y

def choose_wider_dir(left_score, right_score):
    if left_score > right_score:
        return -1
    else:
        return 1

def choose_open_dir(left_open_score, right_open_score, left_score, right_score):
    diff = abs(left_open_score - right_open_score)
    if diff > 300.0:
        if left_open_score > right_open_score:
            return -1
        else:
            return 1
    return choose_wider_dir(left_score, right_score)

def detect_target(frame, target):

    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)

    if target == TARGET_RED:

        mask1 = cv2.inRange(
            hsv,
            np.array([0,120,80]),
            np.array([10,255,255])
        )

        mask2 = cv2.inRange(
            hsv,
            np.array([160,120,80]),
            np.array([179,255,255])
        )

        mask = cv2.bitwise_or(mask1, mask2)

    elif target == TARGET_YELLOW:

        mask = cv2.inRange(
            hsv,
            np.array([20,120,120]),
            np.array([35,255,255])
        )

    else:

        mask = cv2.inRange(
            hsv,
            np.array([95,120,80]),
            np.array([130,255,255])
        )

    kernel = np.ones((5,5), np.uint8)

    mask = cv2.morphologyEx(
        mask,
        cv2.MORPH_OPEN,
        kernel
    )

    mask = cv2.morphologyEx(
        mask,
        cv2.MORPH_CLOSE,
        kernel
    )

    area_ratio = np.count_nonzero(mask) / mask.size

    contours, _ = cv2.findContours(
        mask,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
    )

    if not contours:
        return False, 0.0, 0

    c = max(contours, key=cv2.contourArea)

    area = cv2.contourArea(c)

    x, y, w, h = cv2.boundingRect(c)

    if target == TARGET_RED:
        box_color = (0, 0, 255)
        label = "RED"

    elif target == TARGET_YELLOW:
        box_color = (0, 255, 255)
        label = "YELLOW"

    else:
        box_color = (255, 0, 0)
        label = "BLUE"
    
    cv2.rectangle(frame, (x, y), (x + w, y + h), box_color, 2)

    cv2.putText(
        frame,
        label,
        (x, y - 10),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.8,
        box_color,
        2
    )

    if area < 300:
        return False, 0.0, area

    M = cv2.moments(c)

    if M["m00"] == 0:
        return False, 0.0, area

    cx = int(M["m10"] / M["m00"])

    center = frame.shape[1] / 2

    steer = (cx - center) / center
    steer = clamp(steer, -0.60, 0.60)

    cv2.imshow("Color Detection", frame)
    cv2.waitKey(1)

    return True, steer, area

# ============================================================
# 6. LiDAR 초기화
# ============================================================

ser_L.write(bytes([0xA5, 0x40]))  # RESET
time.sleep(1.0)
ser_L.write(bytes([0xA5, 0x20]))  # SCAN
time.sleep(0.05)

try:
    ser_L.read(7)  # response descriptor
except Exception:
    pass

print("="*60)
print("넓은 전방 열린 길 판단 LiDAR 장애물 회피 시작")
print("RC카 크기: 20cm x 20cm, 라이다 위치: 정중앙")
print("구조: NORMAL → BACK → ESCAPE")
print(f"PATH_HALF_WIDTH = {PATH_HALF_WIDTH:.0f} mm")
print(f"PATH_CHECK_DIST = {PATH_CHECK_DIST:.0f} mm")
print(f"PATH_DANGER_DIST = {PATH_DANGER_DIST:.0f} mm")
print(f"LOOKAHEAD_DIST = {LOOKAHEAD_DIST:.0f} mm")
print(f"OPEN_SIDE_WIDTH = {OPEN_SIDE_WIDTH:.0f} mm")
print("="*60)

# ============================================================
# 7. 스캔 누적 변수 초기화
# ============================================================

scan_buf = []

path_cnt = 0
path_min = 9999.0

front_close_cnt = 0
front_min = 9999.0

left_score = 0.0
right_score = 0.0
left_cnt = 0
right_cnt = 0

left_open_score = 0.0
right_open_score = 0.0
center_block_cnt = 0
center_min = 9999.0

# ============================================================
# 8. 메인 제어 루프
# ============================================================

try:
    while True:
        data = ser_L.read(5)
        if len(data) != 5:
            continue

        s_flag = data[0] & 0x01
        s_inv_flag = (data[0] & 0x02) >> 1
        if s_inv_flag != (1 - s_flag):
            continue

        check_bit = data[1] & 0x01
        if check_bit != 1:
            continue

        quality = data[0] >> 2
        if quality == 0:
            continue

        angle_q6 = ((data[1] >> 1) | (data[2] << 7))
        angle = angle_q6 / 64.0

        distance_q2 = data[3] | (data[4] << 8)
        distance = distance_q2 / 4.0

        if distance < MIN_DIST:
            continue

        scan_buf.append((angle, distance))
        x, y = polar_to_xy(angle, distance)

        # --------------------------------------------------------
        # 1) 경로 검사 - 정면 통로
        if 0 < x < PATH_CHECK_DIST and abs(y) < PATH_HALF_WIDTH:
            path_cnt += 1
            path_min = min(path_min, x)

        # --------------------------------------------------------
        # 2) 진짜 막힘 판단 - 아주 가까운 정면
        if 0 < x < STUCK_FRONT_DIST and abs(y) < PATH_HALF_WIDTH:
            front_close_cnt += 1
            front_min = min(front_min, x)

        # --------------------------------------------------------
        # 3) 좌우 여유 공간 점수 계산
        if 0 < x < SIDE_CHECK_DIST:
            score = min(distance, SIDE_MAX_SCORE_DIST)
            if y < -PATH_HALF_WIDTH:
                left_score += score
                left_cnt += 1
            elif y > PATH_HALF_WIDTH:
                right_score += score
                right_cnt += 1

        # --------------------------------------------------------
        # 4) 전방 열린 길 판단
        if 0 < x < LOOKAHEAD_DIST:
            if abs(y) < CENTER_WIDTH:
                center_block_cnt += 1
                center_min = min(center_min, x)
            elif -OPEN_SIDE_WIDTH < y < -CENTER_WIDTH:
                left_open_score += min(x, LOOKAHEAD_DIST)
            elif CENTER_WIDTH < y < OPEN_SIDE_WIDTH:
                right_open_score += min(x, LOOKAHEAD_DIST)

        s_flag = data[0] & 0x01
        # 스캔 1바퀴 완료 판정 및 주기적 장애물 판단
        if s_flag == 1 and len(scan_buf) > 15:
            path_blocked = (path_cnt >= PATH_BLOCK_POINTS and path_min < PATH_DANGER_DIST)
            center_blocked_ahead = (center_block_cnt >= CENTER_BLOCK_POINTS and center_min < CENTER_BLOCK_DIST)
            stuck = (front_close_cnt >= STUCK_POINTS and front_min < STUCK_FRONT_DIST)

            open_dir = choose_open_dir(left_open_score, right_open_score, left_score, right_score)

            frame = picam2.capture_array()
            visible, color_steer, area = detect_target(frame, target_color)

            if visible:
                last_seen_time = time.time()
                last_steer = color_steer
            elif time.time() - last_seen_time < COLOR_MEMORY_TIME:
                visible = True
                color_steer = last_steer

            if area > ARRIVE_AREA:
                if arrive_start is None:
                    arrive_start = time.time()
                elif time.time() - arrive_start > ARRIVE_TIME:
                    send_forward(0.0, 0.0)
                    print("TARGET ARRIVED")
                    time.sleep(1.0)
                    target_color += 1
                    arrive_start = None
                    if target_color >= TARGET_DONE:
                        print("MISSION COMPLETE")
                        cleanup()
                        break
            else:
                arrive_start = None

            # 상태 머신 제어
            if mode == MODE_BACK:
                send_backward(BACK_SPEED)
                back_count -= 1
                print(f"BACK remain={back_count} escape_dir={escape_dir}")
                if back_count <= 0:
                    mode = MODE_ESCAPE
                    escape_count = ESCAPE_CYCLES

            elif mode == MODE_ESCAPE:
                real_steer = STEER_SIGN * ESCAPE_STEER * escape_dir
                send_forward(real_steer, ESCAPE_SPEED)
                escape_count -= 1
                print(f"ESCAPE dir={escape_dir} real_steer={real_steer:.2f} remain={escape_count}")
                if escape_count <= 0:
                    mode = MODE_NORMAL

            else:  # MODE_NORMAL
                if stuck:
                    escape_dir = open_dir
                    mode = MODE_BACK
                    back_count = BACK_CYCLES
                    send_backward(BACK_SPEED)
                    print(f"STUCK → BACK front_min={front_min:.0f} front_cnt={front_close_cnt} Lopen={left_open_score:.0f} Ropen={right_open_score:.0f} escape_dir={escape_dir}")

                elif path_blocked or center_blocked_ahead:
                    steer = AVOID_STEER * open_dir
                    real_steer = STEER_SIGN * steer
                    if visible:
                        final_steer = 0.8 * color_steer + 0.2 * real_steer
                    else:
                        final_steer = real_steer
                    send_forward(final_steer, AVOID_SPEED)

                    print(f"OPEN_AVOID path_min={path_min:.0f} path_cnt={path_cnt} center_min={center_min:.0f} center_cnt={center_block_cnt} Lopen={left_open_score:.0f} Ropen={right_open_score:.0f} open_dir={open_dir} real_steer={real_steer:.2f}")

                else:
                    if visible:
                        send_forward(color_steer, NORMAL_SPEED)
                    else:
                        send_forward(0.0, NORMAL_SPEED)

            # ----------------------------------------------------
            # 다음 스캔 초기화
            # ----------------------------------------------------
            scan_buf.clear()
            path_cnt = 0
            path_min = 9999.0
            front_close_cnt = 0
            front_min = 9999.0
            left_score = 0.0
            right_score = 0.0
            left_cnt = 0
            right_cnt = 0
            left_open_score = 0.0
            right_open_score = 0.0
            center_block_cnt = 0
            center_min = 9999.0

except KeyboardInterrupt:
    print("종료합니다.")

finally:
    cleanup()
